# Banco local da Universidade — SQLite
# Caminho relativo ao schema (backend/prisma/schema.prisma): use file:./dev.db
# NÃO use file:./prisma/dev.db (cria backend/prisma/prisma/dev.db).
# Na máquina de produção basta copiar o arquivo backend/prisma/dev.db (com o backend parado).
# Caminho absoluto também funciona:
# DB_URL="file:C:/Universidade_Soaco/backend/prisma/dev.db"
DB_URL="file:./dev.db"

# Porta da API. Em produção a mesma porta serve o frontend (pasta dist/ após npm run build na raiz).
APP_PORT=4000
NODE_ENV=development

# Obrigatório em produção. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-isto-por-uma-chave-segura

# Atrás de nginx/IIS com HTTPS
# TRUST_PROXY=true
# Cookie de sessão só em HTTPS
# COOKIE_SECURE=true

# Senha inicial dos usuários criados pelo seed (npm run seed)
SEED_SENHA_PADRAO=Soaco@2026

# Usuário master (acesso total). A API cria/atualiza esse usuário ao subir;
# a senha do .env sempre prevalece. Em desenvolvimento ela é exibida no terminal.
MASTER_EMAIL=master@soacoindustrial.com
MASTER_SENHA=troque-por-uma-senha-forte

# ─── E-mails (Gmail API, mesmo padrão do Gestão Smart) ───────────────────────
# Trava de segurança: só a máquina de PRODUÇÃO deve usar true. Em desenvolvimento os
# avisos aparecem apenas no terminal (dry-run). O botão "Enviar teste" em Configurações
# funciona mesmo com a trava desligada.
NOTIFICACOES_ENVIO_HABILITADO=false

# Chave que criptografa o Client Secret e o Refresh Token salvos no banco. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Ao trocar a chave, salve a credencial de novo em Configurações → E-mail.
EMAIL_SETTINGS_ENCRYPTION_KEY=

# Endereço que os colaboradores usam para abrir o sistema (links dos e-mails).
APP_PUBLIC_URL=http://localhost:5173