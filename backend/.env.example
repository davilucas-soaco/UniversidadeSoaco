# Banco local da Universidade — SQLite
# Caminho relativo ao schema (backend/prisma/schema.prisma): use file:./dev.db
# NÃO use file:./prisma/dev.db (cria backend/prisma/prisma/dev.db).
# Na máquina de produção basta copiar o arquivo backend/prisma/dev.db (com o backend parado).
# Caminho absoluto também funciona:
# DB_URL="file:C:/Universidade_Soaco/backend/prisma/dev.db"
DB_URL="file:./dev.db"

# Porta da API. Em produção a mesma porta serve o frontend (pasta dist/ após npm run build na raiz).
APP_PORT=4000
NODE_ENV=development

# Obrigatório em produção. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-isto-por-uma-chave-segura

# Atrás de nginx/IIS com HTTPS
# TRUST_PROXY=true
# Cookie de sessão só em HTTPS
# COOKIE_SECURE=true

# Senha inicial dos usuários criados pelo seed (npm run seed)
SEED_SENHA_PADRAO=Soaco@2026
