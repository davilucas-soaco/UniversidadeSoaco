// Prisma schema — SQLite local da Universidade Só Aço.
// O banco inteiro fica em prisma/dev.db: para levar à produção, copie esse arquivo com o backend parado.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DB_URL")
}

// ─── Pessoas e organização ───────────────────────────────────────────────────

/// papel: administrador | gestor_conteudo | colaborador
model Usuario {
  id                String    @id @default(cuid())
  nome              String
  email             String    @unique
  senhaHash         String    @map("senha_hash")
  papel             String    @default("colaborador")
  cargo             String    @default("")
  /// true quando a senha foi definida pelo administrador: o usuário troca no primeiro acesso.
  trocarSenha       Boolean   @default(false) @map("trocar_senha")
  setorId           Int?      @map("setor_id")
  telefone          String?
  localizacao       String?
  fotoUrl           String?   @map("foto_url")
  metaHorasAno      Int       @default(80) @map("meta_horas_ano")
  metaMinutosSemana Int       @default(330) @map("meta_minutos_semana")
  ativo             Boolean   @default(true)
  ultimoLoginEm     DateTime? @map("ultimo_login_em")
  criadoEm          DateTime  @default(now()) @map("criado_em")
  atualizadoEm      DateTime  @updatedAt @map("atualizado_em")

  setor             Setor?               @relation(fields: [setorId], references: [id], onDelete: SetNull)
  classes           ClasseMembro[]
  atribuicoes       Atribuicao[]         @relation("AtribuicaoUsuario")
  atribuicoesFeitas Atribuicao[]         @relation("AtribuicaoAutor")
  matriculas        Matricula[]
  aulasConcluidas   AulaProgresso[]
  etapasConcluidas  EtapaProgresso[]
  tentativasProva   ProvaTentativa[]
  avaliacoes        AvaliacaoResultado[]
  avaliacoesCurso   CursoAvaliacao[]
  certificados      Certificado[]
  pontuacoes        PontuacaoEvento[]
  sessoesEstudo     SessaoEstudo[]
  atividades        Atividade[]

  @@index([setorId])
  @@map("usuario")
}

model Setor {
  id          Int          @id @default(autoincrement())
  nome        String       @unique
  usuarios    Usuario[]
  atribuicoes Atribuicao[]

  @@map("setor")
}

/// Categoria de curso, cadastrada em Configurações. O curso guarda o nome em `Curso.categoria`.
model Categoria {
  id       Int      @id @default(autoincrement())
  nome     String   @unique
  criadoEm DateTime @default(now()) @map("criado_em")

  @@map("categoria")
}

/// Grupo livre de colaboradores, independente do setor (ex.: Brigada de emergência, Novos colaboradores).
model Classe {
  id          Int            @id @default(autoincrement())
  nome        String         @unique
  descricao   String?
  criadoEm    DateTime       @default(now()) @map("criado_em")
  membros     ClasseMembro[]
  atribuicoes Atribuicao[]

  @@map("classe")
}

model ClasseMembro {
  classeId  Int      @map("classe_id")
  usuarioId String   @map("usuario_id")
  criadoEm  DateTime @default(now()) @map("criado_em")

  classe  Classe  @relation(fields: [classeId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([classeId, usuarioId])
  @@index([usuarioId])
  @@map("classe_membro")
}

// ─── Catálogo ────────────────────────────────────────────────────────────────

model Instrutor {
  id       String  @id @default(cuid())
  nome     String
  titulo   String
  iniciais String
  bio      String?
  /// Texto livre exibido no card do instrutor (ex.: "18 turmas · 1.420 colaboradores treinados")
  resumo   String?
  cursos   Curso[]

  @@map("instrutor")
}

/// capaCor: navy | sand | ocean | steel | gold
/// capaIcone: building | flag | shield | clipboard | chart | workflow | heart | book
/// tipoConteudo: NULL (curso com módulos) | video | document
model Curso {
  id            String   @id @default(cuid())
  titulo        String
  categoria     String
  descricao     String
  cargaHoraria  Float    @map("carga_horaria")
  pontos        Int      @default(0)
  capaCor       String   @default("navy") @map("capa_cor")
  capaIcone     String   @default("book") @map("capa_icone")
  capaImagem    String?  @map("capa_imagem")
  instrutorId   String?  @map("instrutor_id")
  /// JSON com a lista de objetivos (string[])
  objetivos     String   @default("[]")
  tipoConteudo  String?  @map("tipo_conteudo")
  videoUrl      String?  @map("video_url")
  videoProvedor String?  @map("video_provedor")
  embedUrl      String?  @map("embed_url")
  /// true = o colaborador conclui as etapas na ordem cadastrada
  sequenciaObrigatoria Boolean @default(false) @map("sequencia_obrigatoria")
  /// true = ao concluir o curso o colaborador recebe o certificado
  geraCertificado Boolean @default(true) @map("gera_certificado")
  publicado     Boolean  @default(true)
  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")

  instrutor    Instrutor?    @relation(fields: [instrutorId], references: [id], onDelete: SetNull)
  modulos      Modulo[]
  atribuicoes  Atribuicao[]
  matriculas   Matricula[]
  certificados Certificado[]
  pontuacoes   PontuacaoEvento[]
  sessoes      SessaoEstudo[]
  avaliacoes   CursoAvaliacao[]
  documentos   CursoDocumento[]
  etapas       CursoEtapa[]

  @@index([instrutorId])
  @@map("curso")
}

/// Arquivo de apoio do curso (PDF, Word, Excel). O arquivo fica em backend/var/uploads/cursos/<cursoId>/.
model CursoDocumento {
  id       String   @id @default(cuid())
  cursoId  String   @map("curso_id")
  /// Etapa dona do arquivo (cursos com etapas).
  etapaId  String?  @map("etapa_id")
  nome     String
  mime     String
  tamanho  Int
  /// Caminho relativo a backend/var/uploads
  arquivo  String
  ordem    Int      @default(0)
  criadoEm DateTime @default(now()) @map("criado_em")

  curso Curso       @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  etapa CursoEtapa? @relation(fields: [etapaId], references: [id], onDelete: Cascade)

  @@index([cursoId])
  @@index([etapaId])
  @@map("curso_documento")
}

/// Etapa do curso (pipeline). paiId preenchido = subetapa (um nível só).
/// Etapa com subetapas é um grupo: o conteúdo (vídeo ou documentos) fica nas subetapas.
/// tipoConteudo: video | document
model CursoEtapa {
  id            String   @id @default(cuid())
  cursoId       String   @map("curso_id")
  paiId         String?  @map("pai_id")
  ordem         Int
  titulo        String
  descricao     String?
  tipoConteudo  String?  @map("tipo_conteudo")
  videoUrl      String?  @map("video_url")
  videoProvedor String?  @map("video_provedor")
  embedUrl      String?  @map("embed_url")
  /// Prova do banco de provas (etapa com tipo_conteudo = 'exam').
  provaId       String?  @map("prova_id")
  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")

  curso      Curso            @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  pai        CursoEtapa?      @relation("EtapaFilhas", fields: [paiId], references: [id], onDelete: Cascade)
  filhas     CursoEtapa[]     @relation("EtapaFilhas")
  prova      Prova?           @relation(fields: [provaId], references: [id], onDelete: SetNull)
  documentos CursoDocumento[]
  progresso  EtapaProgresso[]
  tentativas ProvaTentativa[]

  @@index([cursoId])
  @@index([paiId])
  @@index([provaId])
  @@map("curso_etapa")
}

/// Prova reutilizável (cadastrada em Configurações e escolhida nas etapas dos cursos).
model Prova {
  id           String   @id @default(cuid())
  titulo       String
  descricao    String?
  /// Percentual mínimo de acertos para aprovar (0–100).
  notaMinima   Int      @default(70) @map("nota_minima")
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  perguntas  ProvaPergunta[]
  etapas     CursoEtapa[]
  tentativas ProvaTentativa[]

  @@map("prova")
}

model ProvaPergunta {
  id        String @id @default(cuid())
  provaId   String @map("prova_id")
  ordem     Int
  enunciado String

  prova  Prova        @relation(fields: [provaId], references: [id], onDelete: Cascade)
  opcoes ProvaOpcao[]

  @@index([provaId])
  @@map("prova_pergunta")
}

model ProvaOpcao {
  id         String  @id @default(cuid())
  perguntaId String  @map("pergunta_id")
  ordem      Int
  texto      String
  correta    Boolean @default(false)

  pergunta ProvaPergunta @relation(fields: [perguntaId], references: [id], onDelete: Cascade)

  @@index([perguntaId])
  @@map("prova_opcao")
}

/// Cada envio de prova feito por um colaborador numa etapa.
model ProvaTentativa {
  id        String   @id @default(cuid())
  usuarioId String   @map("usuario_id")
  provaId   String   @map("prova_id")
  etapaId   String   @map("etapa_id")
  acertos   Int
  total     Int
  /// Percentual de acertos (0–100).
  nota      Int
  aprovado  Boolean
  /// JSON { perguntaId: opcaoId } com as respostas marcadas.
  respostas String
  criadoEm  DateTime @default(now()) @map("criado_em")

  usuario Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  prova   Prova      @relation(fields: [provaId], references: [id], onDelete: Cascade)
  etapa   CursoEtapa @relation(fields: [etapaId], references: [id], onDelete: Cascade)

  @@index([usuarioId, etapaId])
  @@index([provaId])
  @@map("prova_tentativa")
}

model EtapaProgresso {
  usuarioId   String   @map("usuario_id")
  etapaId     String   @map("etapa_id")
  concluidaEm DateTime @default(now()) @map("concluida_em")

  usuario Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  etapa   CursoEtapa @relation(fields: [etapaId], references: [id], onDelete: Cascade)

  @@id([usuarioId, etapaId])
  @@index([etapaId])
  @@map("etapa_progresso")
}

model Modulo {
  id      String  @id @default(cuid())
  cursoId String  @map("curso_id")
  ordem   Int
  titulo  String
  resumo  String?

  curso Curso  @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  aulas Aula[]

  @@unique([cursoId, ordem])
  @@map("modulo")
}

/// tipo: video | pdf | quiz
model Aula {
  id          String  @id @default(cuid())
  moduloId    String  @map("modulo_id")
  ordem       Int
  titulo      String
  tipo        String
  duracaoMin  Int?    @map("duracao_min")
  paginas     Int?
  questoes    Int?
  pontos      Int?
  obrigatoria Boolean @default(false)

  modulo     Modulo               @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  progresso  AulaProgresso[]
  avaliacoes AvaliacaoResultado[]

  @@unique([moduloId, ordem])
  @@map("aula")
}

// ─── Atribuição de cursos ────────────────────────────────────────────────────

/// Um curso chega ao colaborador por um destes alvos:
///   alvo = usuario → usuarioId preenchido
///   alvo = setor   → setorId preenchido (todos do setor)
///   alvo = classe  → classeId preenchido (todos os membros da classe)
/// prazo: data limite (yyyy-mm-dd), usada principalmente nos obrigatórios.
model Atribuicao {
  id             String   @id @default(cuid())
  cursoId        String   @map("curso_id")
  alvo           String
  usuarioId      String?  @map("usuario_id")
  setorId        Int?     @map("setor_id")
  classeId       Int?     @map("classe_id")
  obrigatorio    Boolean  @default(false)
  prazo          String?
  atribuidoPorId String?  @map("atribuido_por_id")
  criadoEm       DateTime @default(now()) @map("criado_em")

  curso       Curso    @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  usuario     Usuario? @relation("AtribuicaoUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)
  setor       Setor?   @relation(fields: [setorId], references: [id], onDelete: Cascade)
  classe      Classe?  @relation(fields: [classeId], references: [id], onDelete: Cascade)
  atribuidoPor Usuario? @relation("AtribuicaoAutor", fields: [atribuidoPorId], references: [id], onDelete: SetNull)

  @@index([cursoId])
  @@index([usuarioId])
  @@index([setorId])
  @@index([classeId])
  @@map("atribuicao")
}

// ─── Progresso do colaborador ────────────────────────────────────────────────

/// status: pendente | em_andamento | concluido
model Matricula {
  id             String    @id @default(cuid())
  usuarioId      String    @map("usuario_id")
  cursoId        String    @map("curso_id")
  status         String    @default("pendente")
  progresso      Int       @default(0)
  iniciadoEm     DateTime? @map("iniciado_em")
  concluidoEm    DateTime? @map("concluido_em")
  /// Primeira vez que o curso foi concluído: pontos, certificado e atividade só são lançados nela.
  primeiraConclusaoEm DateTime? @map("primeira_conclusao_em")
  ultimoAcessoEm DateTime? @map("ultimo_acesso_em")
  criadoEm       DateTime  @default(now()) @map("criado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  curso   Curso   @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, cursoId])
  @@index([cursoId])
  @@map("matricula")
}

model AulaProgresso {
  usuarioId   String   @map("usuario_id")
  aulaId      String   @map("aula_id")
  concluidaEm DateTime @default(now()) @map("concluida_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  aula    Aula    @relation(fields: [aulaId], references: [id], onDelete: Cascade)

  @@id([usuarioId, aulaId])
  @@index([aulaId])
  @@map("aula_progresso")
}

/// nota: 0 a 100
model AvaliacaoResultado {
  id           String   @id @default(cuid())
  usuarioId    String   @map("usuario_id")
  aulaId       String   @map("aula_id")
  nota         Float
  respondidoEm DateTime @default(now()) @map("respondido_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  aula    Aula    @relation(fields: [aulaId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("avaliacao_resultado")
}

/// Avaliação do curso pelo colaborador (aba "Avaliações" da aula). Uma por colaborador e curso.
/// nota: 1 a 5 estrelas
model CursoAvaliacao {
  id           String   @id @default(cuid())
  usuarioId    String   @map("usuario_id")
  cursoId      String   @map("curso_id")
  nota         Int
  comentario   String?
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  curso   Curso   @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, cursoId])
  @@index([cursoId])
  @@map("curso_avaliacao")
}

model Certificado {
  id        String   @id @default(cuid())
  usuarioId String   @map("usuario_id")
  cursoId   String   @map("curso_id")
  codigo    String   @unique
  emitidoEm DateTime @default(now()) @map("emitido_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  curso   Curso   @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, cursoId])
  @@map("certificado")
}

/// Extrato de pontos: a pontuação e o ranking são sempre a soma destes lançamentos.
model PontuacaoEvento {
  id        String   @id @default(cuid())
  usuarioId String   @map("usuario_id")
  cursoId   String?  @map("curso_id")
  pontos    Int
  motivo    String
  criadoEm  DateTime @default(now()) @map("criado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  curso   Curso?  @relation(fields: [cursoId], references: [id], onDelete: SetNull)

  @@index([usuarioId, criadoEm])
  @@index([criadoEm])
  @@map("pontuacao_evento")
}

/// Tempo de estudo registrado pelo player (base da "Dedicação semanal").
model SessaoEstudo {
  id         String   @id @default(cuid())
  usuarioId  String   @map("usuario_id")
  cursoId    String?  @map("curso_id")
  minutos    Int
  iniciadoEm DateTime @map("iniciado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  curso   Curso?  @relation(fields: [cursoId], references: [id], onDelete: SetNull)

  @@index([usuarioId, iniciadoEm])
  @@map("sessao_estudo")
}

/// tipo: completion | progress | assignment | points
model Atividade {
  id        String   @id @default(cuid())
  usuarioId String   @map("usuario_id")
  tipo      String
  descricao String
  criadoEm  DateTime @default(now()) @map("criado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, criadoEm])
  @@map("atividade")
}

/// Credencial de envio de e-mail (Gmail API com OAuth). Segredos criptografados com EMAIL_SETTINGS_ENCRYPTION_KEY.
model EmailProviderSettings {
  id                     String    @id @default(uuid())
  provider               String    @default("gmail_api")
  fromEmail              String    @map("from_email")
  fromName               String    @map("from_name")
  clientId               String    @map("client_id")
  clientSecretEncrypted  String    @map("client_secret_encrypted")
  refreshTokenEncrypted  String    @map("refresh_token_encrypted")
  lastTestedAt           DateTime? @map("last_tested_at")
  lastError              String?   @map("last_error")
  credentialBlockedAt    DateTime? @map("credential_blocked_at")
  credentialBlockCode    String?   @map("credential_block_code")
  credentialBlockSummary String?   @map("credential_block_summary")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@map("email_provider_settings")
}

/// Um registro por e-mail enviado; `chave` única evita disparar a mesma notificação duas vezes.
model EmailDisparoLog {
  id            String   @id @default(cuid())
  categoria     String
  chave         String   @unique
  destinatarios String
  assunto       String
  enviadoEm     DateTime @default(now()) @map("enviado_em")

  @@index([categoria, enviadoEm])
  @@map("email_disparo_log")
}
